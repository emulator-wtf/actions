{
  "name": "@emulator-wtf/actions",
  "version": "0.0.1",
  "description": "emulator.wtf GitHub actions",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc --noEmit && rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' && prettier --check 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix && prettier --write 'src/**/*.ts'"
  },
  "homepage": "https://github.com/emulator-wtf/actions",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "3.9.7",
    "rimraf": "^6.1.2",
    "rollup": "^4.63.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
